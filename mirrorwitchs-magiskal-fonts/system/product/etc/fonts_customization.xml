<?xml version="1.0" encoding="utf-8"?>
<!-- Modified for module: mirrorwitchs-magiskal-fonts -->
<fonts-modification version="1">
    <family customizationType="new-named-family" name="lato">
        <font weight="400" style="normal">Lato-Regular.ttf</font>
        <font weight="400" style="italic">Lato-Italic.ttf</font>
        <font weight="500" style="normal">Lato-Medium.ttf</font>
        <font weight="500" style="italic">Lato-MediumItalic.ttf</font>
        <font weight="700" style="normal">Lato-Bold.ttf</font>
        <font weight="700" style="italic">Lato-BoldItalic.ttf</font>
    </family>
    <alias name="lato-medium" to="lato" weight="500" />
    <alias name="lato-bold" to="lato" weight="700" />

    <family customizationType="new-named-family" name="rubik">
        <font weight="400" style="normal">Rubik-Regular.ttf</font>
        <font weight="400" style="italic">Rubik-Italic.ttf</font>
        <font weight="500" style="normal">Rubik-Medium.ttf</font>
        <font weight="500" style="italic">Rubik-MediumItalic.ttf</font>
        <font weight="700" style="normal">Rubik-Bold.ttf</font>
        <font weight="700" style="italic">Rubik-BoldItalic.ttf</font>
    </family>
    <alias name="rubik-medium" to="rubik" weight="500" />
    <alias name="rubik-bold" to="rubik" weight="700" />

    <family customizationType="new-named-family" name="bitter">
        <font weight="400" style="normal">Bitter.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="400" style="italic">Bitter-Italic.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="500" style="normal">Bitter.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="500" style="italic">Bitter-Italic.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="700" style="normal">Bitter.ttf<axis tag="wght" stylevalue="700" /></font>
        <font weight="700" style="italic">Bitter-Italic.ttf<axis tag="wght" stylevalue="700" /></font>
    </family>
    <alias name="bitter-medium" to="bitter" weight="500" />
    <alias name="bitter-bold" to="bitter" weight="700" />

    <family customizationType="new-named-family" name="shantell-sans">
        <font weight="400" style="normal">ShantellSans.ttf<axis tag="wght" stylevalue="400" /></font>
        <font weight="400" style="italic">ShantellSans.ttf<axis tag="wght" stylevalue="400" /><axis tag="ital" stylevalue="1" /></font>
        <font weight="500" style="normal">ShantellSans.ttf<axis tag="wght" stylevalue="500" /></font>
        <font weight="500" style="italic">ShantellSans.ttf<axis tag="wght" stylevalue="500" /><axis tag="ital" stylevalue="1" /></font>
        <font weight="800" style="normal">ShantellSans.ttf<axis tag="wght" stylevalue="800" /></font>
        <font weight="800" style="italic">ShantellSans.ttf<axis tag="wght" stylevalue="800" /><axis tag="ital" stylevalue="1" /></font>
    </family>
    <alias name="shantell-sans-medium" to="shantell-sans" weight="500" />
    <alias name="shantell-sans-bold" to="shantell-sans" weight="800" />

</fonts-modification>
